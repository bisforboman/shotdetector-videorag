<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- ShotDetector from nuget.org (FrameReader comes with it). -->
    <PackageVersion Include="ShotDetector" Version="3.26.0" />
    <!-- Microsoft.Extensions.DataIngestion is preview and ships monthly: pinned, moved by Dependabot. -->
    <PackageVersion Include="Microsoft.Extensions.DataIngestion" Version="10.11.0-preview.1.26513.7" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.1" />
    <PackageVersion Include="Microsoft.SemanticKernel.Connectors.InMemory" Version="1.74.0-preview" />
    <!-- Transcripts: the soundtrack decoded in managed code (MP4/AVI/ADTS, AAC), transcribed by whisper.cpp. -->
    <PackageVersion Include="ManagedCodecs.Aac" Version="0.5.0" />
    <PackageVersion Include="ManagedCodecs.Containers" Version="0.5.0" />
    <PackageVersion Include="Whisper.net" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime" Version="1.9.1" />
    <!-- Sentence-aware chunks (the sentences option): StanzaSharp's tokenizer, managed, and its MEDI chunker. A preview while MEDI is. -->
    <PackageVersion Include="StanzaSharp.DataIngestion" Version="1.15.0-preview" />
    <!-- Tests. -->
    <PackageVersion Include="GitHubActionsTestLogger" Version="3.0.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
